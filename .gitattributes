# Unified patches require a leading space on blank context lines.
*.patch -whitespace

# Preserve byte-exact upstream snapshots, including original whitespace.
# Their hashes and line spans are checked by the offline inventory validator.
corpus/upstream/** -whitespace

# Complete canonical modern source spans retain their original blank-line spaces.
puzzles/modern-let-product/reference.clsp -whitespace
puzzles/modern-named-map/reference.clsp -whitespace
puzzles/modern-lambda-map/reference.clsp -whitespace

# Retained case-study observations include exact upstream bytes, process logs
# and a deliberately whitespace-only oversized checkpoint refusal input.
corpus/xchandles-premine-history-v2/** -whitespace
corpus/xchandles-simulator/** -whitespace

# Preserve exact Cargo stdout, including its terminal blank line.
experiments/continuation-batches/success-evidence/native.stdout whitespace=-blank-at-eof
experiments/spuds/success-evidence/native.stdout whitespace=-blank-at-eof
experiments/stateful-ledger/evidence/runner-native.stdout whitespace=-blank-at-eof
