@@ -0,0 +1,109 @@
+use std::path::Path;
+
+use clvmr::{Allocator, ChiaDialect, MEMPOOL_MODE, error::EvalErr, run_program};
+use rue_compiler::{Compiler, FileTree, normalize_path};
+use rue_diagnostic::DiagnosticSeverity;
+use rue_options::CompilerOptions;
+
+#[derive(Debug, PartialEq, Eq)]
+enum Observation {
+    InvalidOpArg,
+    Raise,
+    CostExceeded,
+}
+
+fn check_diagnostics(compiler: &mut Compiler, root: &Path) {
+    let errors = compiler
+        .take_diagnostics()
+        .into_iter()
+        .filter(|diagnostic| diagnostic.kind.severity() == DiagnosticSeverity::Error)
+        .map(|diagnostic| diagnostic.message(root))
+        .collect::<Vec<_>>();
+    assert!(errors.is_empty(), "{}", errors.join("\n"));
+}
+
+fn observe(fixture: &str, optimize: bool, pair_input: bool) -> Observation {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests/fixtures/nested_bitwise")
+        .join(fixture);
+    let root = path.parent().unwrap();
+    let mut compiler = Compiler::new(CompilerOptions {
+        optimize_lir: optimize,
+        auto_inline: true,
+        optimize_static_pairs: false,
+        debug_symbols: false,
+        ..CompilerOptions::default()
+    });
+    let tree = FileTree::compile_file(&mut compiler, &path);
+    check_diagnostics(&mut compiler, root);
+    let tree = tree.unwrap();
+    let mut allocator = Allocator::new();
+    let program = tree.main(
+        &mut compiler,
+        &mut allocator,
+        &normalize_path(&path).unwrap(),
+        root.to_owned(),
+    );
+    check_diagnostics(&mut compiler, root);
+    let program = program.unwrap().unwrap();
+    let one = allocator.new_atom(&[1]).unwrap();
+    let environment = if pair_input {
+        let two = allocator.new_atom(&[2]).unwrap();
+        allocator.new_pair(one, two).unwrap()
+    } else {
+        one
+    };
+    match run_program(
+        &mut allocator,
+        &ChiaDialect::new(MEMPOOL_MODE),
+        program,
+        environment,
+        1_000_000,
+    ) {
+        Err(EvalErr::InvalidOpArg(_, _)) => Observation::InvalidOpArg,
+        Err(EvalErr::Raise(_)) => Observation::Raise,
+        Err(EvalErr::CostExceeded) => Observation::CostExceeded,
+        Err(error) => panic!("unexpected VM failure: {error:?}"),
+        Ok(_) => panic!("the recursive control unexpectedly returned"),
+    }
+}
+
+#[test]
+fn source_logand_keeps_rejection_of_a_malformed_external_input() {
+    for optimize in [false, true] {
+        assert_eq!(
+            observe("and.rue", optimize, true),
+            Observation::InvalidOpArg,
+            "optimize={optimize}",
+        );
+    }
+}
+
+#[test]
+fn source_logior_keeps_rejection_of_a_malformed_external_input() {
+    for optimize in [false, true] {
+        assert_eq!(
+            observe("or.rue", optimize, true),
+            Observation::InvalidOpArg,
+            "optimize={optimize}",
+        );
+    }
+}
+
+#[test]
+fn an_explicit_source_type_guard_still_rejects_both_modes() {
+    for fixture in ["guarded_and.rue", "guarded_or.rue"] {
+        for optimize in [false, true] {
+            assert_eq!(observe(fixture, optimize, true), Observation::Raise);
+        }
+    }
+}
+
+#[test]
+fn well_typed_inputs_still_reach_the_recursive_operand() {
+    for fixture in ["and.rue", "or.rue", "guarded_and.rue", "guarded_or.rue"] {
+        for optimize in [false, true] {
+            assert_eq!(observe(fixture, optimize, false), Observation::CostExceeded);
+        }
+    }
+}
