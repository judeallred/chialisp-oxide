+/// Postorder scheduling preserves the former recursive allocation order. Do
+/// not memoize emitted nodes: repeated DAG edges historically allocate again.
+fn push_program_children(arena: &Arena<Lir>, lir: LirId, work: &mut Vec<Work>) -> Result<()> {
+    let mut push = |id| work.push(Work::Visit(id, Mode::Program));
+    match &arena[lir] {
+        Lir::Atom(_) | Lir::Path(_) => (),
+        Lir::Quote(id)
+        | Lir::First(id)
+        | Lir::Rest(id)
+        | Lir::Listp(id, _)
+        | Lir::Not(id)
+        | Lir::Strlen(id)
+        | Lir::Lognot(id)
+        | Lir::PubkeyForExp(id)
+        | Lir::G1Negate(id)
+        | Lir::G2Negate(id)
+        | Lir::Op(_, id)
+        | Lir::DebugPrint(_, id) => push(*id),
+        Lir::Run(a, b)
+        | Lir::Cons(a, b)
+        | Lir::Div(a, b)
+        | Lir::Divmod(a, b)
+        | Lir::Mod(a, b)
+        | Lir::Eq(a, b)
+        | Lir::Gt(a, b)
+        | Lir::GtBytes(a, b)
+        | Lir::Ash(a, b)
+        | Lir::Lsh(a, b)
+        | Lir::G1Multiply(a, b)
+        | Lir::G2Multiply(a, b) => {
+            push(*b);
+            push(*a);
+        }
+        Lir::Modpow(a, b, c)
+        | Lir::CoinId(a, b, c)
+        | Lir::K1Verify(a, b, c)
+        | Lir::R1Verify(a, b, c)
+        | Lir::If(a, b, c, _) => {
+            push(*c);
+            push(*b);
+            push(*a);
+        }
+        Lir::Add(args)
+        | Lir::Sub(args)
+        | Lir::Mul(args)
+        | Lir::All(args)
+        | Lir::Any(args)
+        | Lir::Raise(args)
+        | Lir::Concat(args)
+        | Lir::Logand(args)
+        | Lir::Logior(args)
+        | Lir::Logxor(args)
+        | Lir::G1Add(args)
+        | Lir::G1Subtract(args)
+        | Lir::G2Add(args)
+        | Lir::G2Subtract(args)
+        | Lir::BlsPairingIdentity(args)
+        | Lir::Sha256(args)
+        | Lir::Sha256Inline(args)
+        | Lir::Keccak256(args)
+        | Lir::Keccak256Inline(args) => {
+            for id in args.iter().rev() {
+                push(*id);
+            }
+        }
+        Lir::Closure(..) => return Err(crate::Error::CodegenChildren),
+        Lir::BlsVerify(first, args) => {
+            for id in args.iter().rev() {
+                push(*id);
+            }
+            push(*first);
+        }
+        Lir::Substr(first, start, end) => {
+            if let Some(end) = end {
+                push(*end);
+            }
+            push(*start);
+            push(*first);
+        }
+        Lir::G1Map(first, dst) | Lir::G2Map(first, dst) => {
+            if let Some(dst) = dst {
+                push(*dst);
+            }
+            push(*first);
+        }
+    }
+    Ok(())
+}
