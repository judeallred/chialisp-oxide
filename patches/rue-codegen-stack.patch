+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+enum Mode {
+    Program,
+    Static,
+}
+#[derive(Clone, Copy)]
+enum Finish {
+    Program,
+    Static,
+    QuotedPair,
+    StaticApply,
+}
+enum Work {
+    Visit(LirId, Mode),
+    Finish {
+        lir: LirId,
+        mode: Mode,
+        kind: Finish,
+        start: usize,
+    },
+    ClosureStart {
+        lir: LirId,
+        start: usize,
+    },
+    ClosureNext {
+        lir: LirId,
+        start: usize,
+        function: NodePtr,
+        args: NodePtr,
+        remaining: usize,
+    },
+    ClosureWrap {
+        lir: LirId,
+        start: usize,
+        function: NodePtr,
+        args: NodePtr,
+        remaining: usize,
+    },
+}
