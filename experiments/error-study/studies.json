{
  "schema_version": 1,
  "scope": "Original deliberately faulty teaching fixtures. Weak suites assert exact outcomes but intentionally omit a distinguishing input. Each study names the layer that catches the mistake: native Rust type or name checking, native overflow checks, the compiled strict ABI or checked arithmetic recorded in the referenced corpus case, or none for the negative controls. These are host Rust compiler/tests and independent Chialisp/Rue VM executions plus references to executed corpus cases, not Rust-to-CLVM or consensus proofs.",
  "studies": [
    {
      "id": "domain-swap",
      "title": "Coin ID used as a payment destination",
      "category": "rust_typecheck",
      "rust_error": "E0308",
      "claim": "Distinct SDK CoinId and PuzzleHash types reject this direct argument swap, even though both contain 32 bytes.",
      "limitations": [
        "The guarantee relies on choosing distinct domain types. Deliberately wrapping coin_id.0 as PuzzleHash still compiles and needs policy review.",
        "The equal-width Rue Bytes32 annotations do not express distinct domains. A separately executed Rue distinct-struct control rejects the same domain swap; this is not a unique Rust capability."
      ],
      "weak_suite": [
        {
          "name": "equal fixture identities, seven mojos",
          "input": "(0x1111111111111111111111111111111111111111111111111111111111111111 0x1111111111111111111111111111111111111111111111111111111111111111 7)",
          "expected": {
            "status": "accepted",
            "tree": [
              [
                51,
                {
                  "bytes": "1111111111111111111111111111111111111111111111111111111111111111"
                },
                7
              ]
            ]
          }
        },
        {
          "name": "equal fixture identities, nine mojos",
          "input": "(0x2222222222222222222222222222222222222222222222222222222222222222 0x2222222222222222222222222222222222222222222222222222222222222222 9)",
          "expected": {
            "status": "accepted",
            "tree": [
              [
                51,
                {
                  "bytes": "2222222222222222222222222222222222222222222222222222222222222222"
                },
                9
              ]
            ]
          }
        }
      ],
      "missed_witness": {
        "name": "distinct recipient and coin ID",
        "input": "(0x4242424242424242424242424242424242424242424242424242424242424242 0x9999999999999999999999999999999999999999999999999999999999999999 7)",
        "expected": {
          "status": "accepted",
          "tree": [
            [
              51,
              {
                "bytes": "4242424242424242424242424242424242424242424242424242424242424242"
              },
              7
            ]
          ]
        }
      },
      "sources": {
        "chialisp": "experiments/error-study/domain-swap/bad.clsp",
        "rust_bad": "experiments/error-study/domain-swap/bad.rs",
        "rust_fixed": "experiments/error-study/domain-swap/fixed.rs",
