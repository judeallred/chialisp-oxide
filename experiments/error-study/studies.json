    {
      "id": "integer-truthiness",
      "title": "Approval code two is accidentally treated as true",
      "category": "rust_typecheck",
      "rust_error": "E0308",
      "claim": "Rust rejects an integer directly used as an if condition; it requires an explicit boolean expression.",
      "limitations": [
        "Rust does not select the intended boolean expression. Writing approved != 0 would recreate the policy bug and compile.",
        "The corrected fixture explicitly asserts approved == 1 at runtime; this policy is not proved by the type checker.",
        "This host-only study does not claim project ABI or Rust-to-CLVM validation."
      ],
      "weak_suite": [
        {
          "name": "approval code one",
          "input": "(1 0x4242424242424242424242424242424242424242424242424242424242424242 7)",
          "expected": {
            "status": "accepted",
            "tree": [
              [
                51,
                {
                  "bytes": "4242424242424242424242424242424242424242424242424242424242424242"
                },
                7
              ]
            ]
          }
        },
        {
          "name": "approval code zero",
          "input": "(() 0x4242424242424242424242424242424242424242424242424242424242424242 7)",
          "expected": {
            "status": "rejected"
          }
        }
      ],
      "missed_witness": {
        "name": "nonzero approval code two",
        "input": "(2 0x4242424242424242424242424242424242424242424242424242424242424242 7)",
        "expected": {
          "status": "rejected"
        }
      },
