; Original independent Chialisp reference for explicit batch-two payouts (#16).
; No upstream program is copied; repository-wide license is undeclared.
; Source/native prototype only: no VM, ledger or cost execution credit yet.
(mod ENV
  (defun two (X)
    (if (l X) (if (l (r X)) (not (r (r X))) ()) ()))
  (defun three (X)
    (if (l X) (if (l (r X)) (two (r X)) ()) ()))
  (defun atom32 (X) (if (l X) () (= (strlen X) 32)))
  (defun ah (X) (sha256 0x01 X))
  (defun ph (L R) (sha256 0x02 L R))
  (defun qh (H) (ph (ah 1) H))
  (defun curry (M P)
    (ph (ah 2)
      (ph (qh M)
        (ph (ph (ah 4) (ph (qh P) (ph (ah 1) (ah ())))) (ah ())))))
  (defun instance (M H N)
    (curry M (ph (ah M) (ph (ah H) (ph (ah N) (ah ()))))))
  (defun end () (sha256 "chialisp-oxide/continuation/v1/end:1000"))
  (defun emit (M H N TO1 MID TO2 NEXT)
    (if (all
          (= (sha256 "chialisp-oxide/continuation/v1/item:1000" TO1 MID) H)
          (not (= MID (end)))
          (= (sha256 "chialisp-oxide/continuation/v1/item:1000" TO2 NEXT) MID)
          (not (= TO1 TO2)))
      (if (= N 2)
        (if (= NEXT (end))
          (list (list 73 2000) (list 51 TO1 1000) (list 51 TO2 1000))
          (x))
        (if (= NEXT (end)) (x)
          (list (list 73 (* 1000 N)) (list 51 TO1 1000) (list 51 TO2 1000)
            (list 51 (instance M NEXT (- N 2)) (* 1000 (- N 2))))))
      (x)))
  (defun checked (M H N TO1 MID TO2 NEXT)
    (if (all (atom32 M) (atom32 H) (atom32 TO1) (atom32 MID) (atom32 TO2) (atom32 NEXT))
      (if (l N) (x)
        (if (all (= (strlen N) 1) (any (= N 2) (= N 4) (= N 6) (= N 8)))
          (emit M H N TO1 MID TO2 NEXT) (x)))
      (x)))
  (defun dispatch (TERMS BATCH)
    (if (three TERMS)
      (if (two BATCH)
        (if (all (two (f BATCH)) (two (f (r BATCH))))
          (checked (f TERMS) (f (r TERMS)) (f (r (r TERMS)))
            (f (f BATCH)) (f (r (f BATCH)))
            (f (f (r BATCH))) (f (r (f (r BATCH)))))
          (x))
        (x))
      (x)))
  (if (two ENV) (dispatch (f ENV) (f (r ENV))) (x))
)
