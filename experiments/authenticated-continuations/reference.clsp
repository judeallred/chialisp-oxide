; Original independent Chialisp reference for the issue-16 ABI/hash spike.
; WIP: this file is not yet executed ledger evidence or a published port.
(mod ENV
  (defun two (X)
    (if (l X) (if (l (r X)) (not (r (r X))) ()) ()))
  (defun three (X)
    (if (l X) (if (l (r X)) (two (r X)) ()) ()))
  (defun atom32 (X)
    (if (l X) () (= (strlen X) 32)))
  (defun ah (X) (sha256 0x01 X))
  (defun ph (L R) (sha256 0x02 L R))
  (defun qh (H) (ph (ah 1) H))
  (defun curry (M P)
    (ph (ah 2)
      (ph (qh M)
        (ph (ph (ah 4) (ph (qh P) (ph (ah 1) (ah ())))) (ah ())))))
  (defun instance (M H N)
    (curry M (ph (ah M) (ph (ah H) (ph (ah N) (ah ()))))))
  (defun end () (sha256 "chialisp-oxide/continuation/v1/end:1000"))
  (defun emit (M H N TO NEXT)
    (if (= (sha256 "chialisp-oxide/continuation/v1/item:1000" TO NEXT) H)
      (if (= N 1)
        (if (= NEXT (end))
          (list (list 73 1000) (list 51 TO 1000))
          (x))
        (if (= NEXT (end)) (x)
          (list (list 73 (* 1000 N)) (list 51 TO 1000)
            (list 51 (instance M NEXT (- N 1)) (* 1000 (- N 1))))))
      (x)))
  (defun checked (M H N TO NEXT)
    (if (all (atom32 M) (atom32 H) (atom32 TO) (atom32 NEXT))
      (if (l N) (x)
        (if (all (= (strlen N) 1) (> N 0) (> 9 N))
          (emit M H N TO NEXT) (x)))
      (x)))
  (defun dispatch (TERMS OPENING)
    (if (three TERMS)
      (if (two OPENING)
        (checked (f TERMS) (f (r TERMS)) (f (r (r TERMS)))
          (f OPENING) (f (r OPENING)))
        (x))
      (x)))
  (if (two ENV) (dispatch (f ENV) (f (r ENV))) (x))
)
