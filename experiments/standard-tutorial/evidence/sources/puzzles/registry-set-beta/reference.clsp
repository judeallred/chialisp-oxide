; Original independent finite beta action. Strict five-argument ABI.
(mod ENV
  (defun atom_hash (VALUE) (sha256 1 VALUE))
  (defun pair_hash (LEFT RIGHT) (sha256 2 LEFT RIGHT))
  (defun quoted_hash (HASH) (pair_hash (atom_hash 1) HASH))
  (defun environment_hash (ARG ENV)
    (pair_hash (atom_hash 4) (pair_hash (quoted_hash ARG) (pair_hash ENV (atom_hash ())))))
  (defun applied_hash (MODULE ENV)
    (pair_hash (atom_hash 2) (pair_hash (quoted_hash MODULE) (pair_hash ENV (atom_hash ())))))
  (defun slot_hash (FIRST ENTRY)
    (applied_hash FIRST (environment_hash (atom_hash ENTRY) (atom_hash 1))))
  (defun entry_hash (NAME VALUE) (pair_hash (atom_hash NAME) (atom_hash VALUE)))
  (defun bytes32 (VALUE)
    (if (l VALUE) (x) (if (= (strlen VALUE) 32) 1 (x))))
  (defun owner48 (VALUE)
    (if (l VALUE) (x) (if (= (strlen VALUE) 48) 1 (x))))
  (defun canonical_bool (VALUE)
    (if (l VALUE) (x) (if (= VALUE ()) 1 (if (= VALUE 1) 1 (x)))))
  (defun checked_truth (TRUTH)
    (if (l TRUTH)
      (if (l (r TRUTH))
        (if (l (r (r TRUTH)))
          (if (canonical_bool (f (r TRUTH)))
            (if (bytes32 (f (r (r TRUTH))))
              (if (bytes32 (r (r (r TRUTH))))
                (if (f TRUTH) (x) 1)
                (x))
              (x))
            (x))
          (x))
        (x))
      (x)))
  (defconstant NAME 0x4189b73b237d357f207cda7acb86b7e5fbff7ae29850dd036f35f2f24a26d0e0)
  (defconstant DOMAIN 0xbff7c4e89153f49382b654dfb28c90c9cabbc13c4c021411e021e23ab81584f6)
  (defun emit_update (OWNER FIRST TRUTH OLD_ENTRY NEW_ENTRY MESSAGE)
    (if (= (r (r (r TRUTH))) OLD_ENTRY)
      (c (c 1 (c 1 (c (f (r (r TRUTH))) NEW_ENTRY)))
         (list (list 66 18 () (slot_hash FIRST OLD_ENTRY))
               (list 51 (slot_hash FIRST NEW_ENTRY) 0 (list FIRST))
               (list 50 OWNER MESSAGE)))
      (x)))
  (defun update (OWNER FIRST TRUTH OLD NEW)
    (if (owner48 OWNER)
      (if (bytes32 FIRST)
        (if (checked_truth TRUTH)
          (if (f (r TRUTH))
            (if (bytes32 OLD)
              (if (bytes32 NEW)
                (emit_update OWNER FIRST TRUTH (entry_hash NAME OLD)
                             (entry_hash NAME NEW) (sha256 DOMAIN OLD NEW))
                (x))
              (x))
            (x))
          (x))
        (x))
      (x)))
  (if (l ENV)
    (if (l (r ENV))
      (if (l (r (r ENV)))
        (if (l (r (r (r ENV))))
          (if (l (r (r (r (r ENV)))))
            (if (r (r (r (r (r ENV))))) (x)
              (update (f ENV) (f (r ENV)) (f (r (r ENV)))
                      (f (r (r (r ENV)))) (f (r (r (r (r ENV)))))))
            (x))
          (x))
        (x))
      (x))
    (x)))
