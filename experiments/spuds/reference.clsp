; Original independent Chialisp reference for finite Spuds (#10).
; No upstream puzzle copied; repository-wide license is undeclared.
; Generated conditions require consensus for age, funding and BLS enforcement.
(mod ENV
  (defun two (X)
    (if (l X) (if (l (r X)) (not (r (r X))) ()) ()))
  (defun four (X)
    (if (l X) (if (l (r X)) (two (r (r X))) ()) ()))
  (defun sized (X N) (if (l X) () (= (strlen X) N)))
  (defun ah (X) (sha256 0x01 X))
  (defun ph (L R) (sha256 0x02 L R))
  (defun qh (H) (ph (ah 1) H))
  (defun curry (M P)
    (ph (ah 2)
      (ph (qh M)
        (ph (ph (ah 4) (ph (qh P) (ph (ah 1) (ah ())))) (ah ())))))
  (defun instance (M K P ROUND)
    (curry M (ph (ah M) (ph (ah K) (ph (ah P) (ph (ah ROUND) (ah ())))))))
  (defun take-message (NEXT)
    (sha256 "chialisp-oxide/spuds/take:v1" NEXT))
  (defun claim-message () (sha256 "chialisp-oxide/spuds/claim:v1"))
  (defun emit (K MESSAGE AMOUNT BOUNDARY DESTINATION OUTPUT)
    (list (list 50 K MESSAGE) (list 73 AMOUNT) (list 82 1)
      (list BOUNDARY 5) (list 51 DESTINATION OUTPUT) (list 60 MESSAGE)))
  (defun taking (K NEXT AMOUNT OUTPUT)
    (emit K (take-message NEXT) AMOUNT 86 NEXT OUTPUT))
  (defun policy (M K P ROUND TAKE NK NP)
    (if TAKE
      (if (> 8 ROUND)
        (taking NK (instance M NK NP (+ ROUND 1)) (* ROUND 1000) (* (+ ROUND 1) 1000))
        (x))
      (emit K (claim-message) (* ROUND 1000) 82 P (* ROUND 1000))))
  (defun checked (M K P ROUND TAKE NK NP)
    (if (all (sized M 32) (sized K 48) (sized P 32) (sized NK 48) (sized NP 32))
      (if (l ROUND) (x)
        (if (all (= (strlen ROUND) 1) (> ROUND 0) (> 9 ROUND))
          (if (l TAKE) (x)
            (if (any (= TAKE ()) (= TAKE 1)) (policy M K P ROUND TAKE NK NP) (x)))
          (x)))
      (x)))
  (defun dispatch (TERMS TAKE NK NP)
    (if (four TERMS)
      (checked (f TERMS) (f (r TERMS)) (f (r (r TERMS))) (f (r (r (r TERMS)))) TAKE NK NP)
      (x)))
  (if (four ENV)
    (dispatch (f ENV) (f (r ENV)) (f (r (r ENV))) (f (r (r (r ENV)))))
    (x))
)
