---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import SourceComparison from '../../components/SourceComparison.astro';
import ArtifactDiff from '../../components/ArtifactDiff.astro';
import RuntimeVersions from '../../components/RuntimeVersions.astro';
import SolutionPreview from '../../components/SolutionPreview.astro';
import CurriedInstances from '../../components/CurriedInstances.astro';
import CurriedExamples from '../../components/CurriedExamples.astro';
import ProtocolValidation from '../../components/ProtocolValidation.astro';
import CompositionCosts from '../../components/CompositionCosts.astro';
import DelegatedConditionsValidation from '../../components/DelegatedConditionsValidation.astro';
import DelegatedSourceControls from '../../components/DelegatedSourceControls.astro';
import { declaredDivergences, puzzles, report, authoring, canonicalExample, canonicalPuzzle, canonicalHelper, helperContract, kindLabel, format, href, backendLabel, singletonProtocol, delegatedProtocol, type PuzzleReport } from '../../lib/data';
export function getStaticPaths() { return puzzles.map(puzzle => ({ params: { slug: puzzle.slug }, props: { puzzle } })); }
const { puzzle } = Astro.props as { puzzle: PuzzleReport };
const canonical = canonicalExample(puzzle);
const canonicalModule = canonicalPuzzle(puzzle);
const helperAdapter = canonicalHelper(puzzle);
const helper = helperContract(puzzle);
const singleton = singletonProtocol(puzzle);
const delegated = delegatedProtocol(puzzle);
const generatedScope = helper?.generated ?? (puzzle.environment === 'ignored' || puzzle.environment === 'raw' ? 'over bounded atom and pair trees' : 'around the scalar policy boundary');
const sourceContract = canonical || canonicalModule
  ? 'The original Chialisp source is independently compiled without adding a wrapper or argument check.'
  : helper ? `The Chialisp comparison embeds the original helper verbatim inside ${helper.adapter}`
  : 'The Chialisp comparison is compiled independently and includes checks for this fixture’s ABI.';
const factoryGroups = new Map<string, NonNullable<PuzzleReport['factory_checks']>>();
for (const check of puzzle.factory_checks ?? []) {
  factoryGroups.set(check.environment, [...(factoryGroups.get(check.environment) ?? []), check]);
}
const applicationCount = (puzzle.factory_checks ?? []).reduce((sum, check) => sum + check.application_runs.length, 0);
const applicationPassed = (check: NonNullable<PuzzleReport['factory_checks']>[number]) => check.application_runs.length > 0 && check.application_runs.every(run => run.expected_outcome ? JSON.stringify(run.execution.outcome) === JSON.stringify(run.expected_outcome) : run.execution.outcome.status === 'accepted' && run.execution.outcome.output_hex === check.expected_output_hex);
const curryFactory = (puzzle.factory_checks ?? []).some(check => check.relation === 'standard_curry');
const headings = [{depth:2,slug:'sources',text:'Compare the sources'}, {depth:2,slug:'artifacts',text:'Compiled artifacts'}, {depth:2,slug:'vectors',text:'Adversarial input vectors'}, {depth:2,slug:'ledger',text:'Ledger validation'}, {depth:2,slug:'provenance',text:'Provenance and versions'}];
if (puzzle.slug === 'p2-singleton') headings.splice(2, 0, {depth:2,slug:'composition-compiler-costs',text:'Composed compiler costs'});
if (puzzle.resource_controls) headings.splice(3,0,{depth:2,slug:'resource-controls',text:'What happens with a smaller budget?'});
if (puzzle.kind === 'program_factory') headings.splice(3,0,{depth:2,slug:'factory',text:'Apply the produced programs'});
if (singleton) headings.splice(headings.findIndex(heading => heading.slug === 'ledger'), 0, {depth:2,slug:'protocol-composition',text:'Validate canonical singleton composition'});
if (delegated) headings.splice(headings.findIndex(heading => heading.slug === 'ledger'), 0, {depth:2,slug:'delegated-owner-instances',text:'Validate owner-key instances'});
if (delegated) headings.splice(headings.findIndex(heading => heading.slug === 'ledger'), 0, {depth:2,slug:'delegated-source-controls',text:'Policy mistakes that still compile'});
if (puzzle.curried_instances) headings.splice(headings.findIndex(heading => heading.slug === 'ledger'),0,{depth:2,slug:'curried-instances',text:'Spend a fixed-hash instance'});
if (puzzle.curried_examples) headings.splice(headings.findIndex(heading => heading.slug === 'ledger'),0,{depth:2,slug:'curry',text:'Curry the module'});
---
<StarlightPage frontmatter={{ title: puzzle.title, description: puzzle.security_scope }} headings={headings}>
  <p class="eyebrow"><a href={href('lab/')}>Puzzle laboratory</a> / {puzzle.slug}</p>
  <p><span class="badge success">validated report</span> <span class="badge">{kindLabel(puzzle.kind)}{puzzle.kind === 'program_factory' ? ' · returns a program' : puzzle.kind === 'pure_function' ? ' · not a coin puzzle' : puzzle.kind === 'protocol_component' ? (delegated ? ' · raw template + owner instances' : ' · requires counterpart spends') : ' · returns conditions'}</span></p>
  {canonical && <p><span class="badge">canonical tutorial {puzzle.reference_mode === 'expression' ? 'expression' : 'module'}</span> <a href={canonical.source.url}>{canonical.title}</a> · differential evidence; parent tutorial remains partial</p>}
  {canonicalModule && <p><span class="badge">canonical puzzle/module port</span> One exact pinned upstream module; source, published artifact identity, and recorded behavior are checked separately.</p>}
  {helperAdapter && <p><span class="badge">published helper adapter</span> An exact pinned helper is invoked by an explicit module wrapper. This is separate from porting the complete upstream source file or preserving a published module hash.</p>}
  <p class="scope">{puzzle.security_scope}</p>
  <div class="metric-grid">
    <div class="metric"><strong>{puzzle.cases.length}</strong><span>named vectors</span></div>
    <div class="metric"><strong>{format(puzzle.generated_cases)}</strong><span>generated inputs</span></div>
    <div class="metric"><strong>{puzzle.simulator.length}</strong><span>ledger scenarios</span></div>
  </div>
  <h2 id="sources">Compare the sources</h2>
  <p>These are the exact source strings recorded in the validation report. Cargo exports <code>{authoring.exports[puzzle.slug].entry}</code> from <code>{authoring.manifest}</code>; the native oracle links the same library. {sourceContract}</p>
  <p class="callout-note">{puzzle.environment === 'ignored'
    ? <>Environment contract: explicitly ignored. This parameterless export accepts any CLVM tree that the VM can parse and process within its resource limits. It adds no proper-list, arity, or scalar encoding check. <a href={href('reference/abi/#explicitly-ignored-environments')}>Read the opt-in ABI contract.</a></>
    : puzzle.environment === 'raw'
    ? <>Environment contract: raw tree. One Rust tree value represents the entire environment, without added argument-list, arity, numeric, or proper-tail decoding. The source determines its own shape checks and payload selection.</>
    : <>Environment contract: strict typed arguments. The entire proper argument list and every declared value encoding are checked before the function body.</>}</p>
  <SourceComparison slug={puzzle.slug} />
  <h2 id="artifacts">Compiled artifacts</h2>
  <p>All five compiled builds from three source languages are compared on the same input trees. Different tree hashes are visible below; equivalent tested behavior does not imply canonical module-hash compatibility.</p>
  <p class="quiet">Rust optimization on runs checked constants, forward success facts, constants again, branch-local integer intervals, legacy tree guards, bounded helper inlining, runtime frame elision, guarded immutable projection forwarding, the lazy canonical-integer decoder, Rue LIR and static pair codegen. Off skips these optional stages; the legacy backward guard pass stays disabled for runtime programs. Rue source on/off controls its LIR optimizer. The report records these pipelines explicitly, while retaining the historical <code>optimize_lir</code> field name. Costs and rejection diagnostics can change between modes. <a href="/chialisp-oxide/reference/optimization/">Inspect the optimization boundary.</a></p>
  <div class="table-scroll"><table><caption>Serialized program sizes and tree hashes</caption><thead><tr><th scope="col">Backend</th><th scope="col">Optimization</th><th scope="col">Bytes</th><th scope="col">CLVM tree hash</th></tr></thead><tbody>
    {puzzle.artifacts.map(artifact => <tr><th scope="row">{artifact.backend === 'rust_mir' ? 'Rust MIR → Rue LIR' : backendLabel(artifact.backend)}</th><td>{artifact.optimize_lir ? 'on' : 'off'}</td><td>{format(artifact.bytes)}</td><td class="hash" data-pagefind-ignore><code>{artifact.tree_hash}</code></td></tr>)}
  </tbody></table></div>
  <ArtifactDiff puzzle={puzzle} />
  {puzzle.slug === 'p2-singleton' && <CompositionCosts compact />}
  {puzzle.module_identity && <section class="module-identity" aria-label="Published module identity">
    <h3>Published module identity</h3>
    <p>Published CLVM tree hash: <code class="dependency-hash" data-pagefind-ignore>{puzzle.module_identity.upstream_tree_hash}</code>. This identifies the original module; derived programs and curried instances have their own commitments. Equal recorded behavior is separate from byte and hash identity.</p>
    <div class="table-scroll"><table><caption>Actual comparison with the pinned published module</caption><thead><tr><th scope="col">Build</th><th scope="col">Optimization</th><th scope="col">Serialized bytes</th><th scope="col">Tree hash</th></tr></thead><tbody>{puzzle.module_identity.comparisons.map(comparison => <tr><th scope="row">{backendLabel(comparison.backend)}</th><td>{comparison.optimize_lir ? 'on' : 'off'}</td><td>{comparison.serialized_bytes_equal ? 'matches' : 'differs'}</td><td>{comparison.tree_hash_equal ? 'matches' : 'differs'}</td></tr>)}</tbody></table></div>
  </section>}
  {puzzle.artifacts.map(artifact => <details class="artifact"><summary>{backendLabel(artifact.backend)} · {artifact.optimize_lir ? 'optimized' : 'unoptimized'} disassembly and serialized bytes</summary><div data-pagefind-ignore><Code code={artifact.disassembly} lang="lisp" /><Code code={artifact.clvm_hex} lang="text" /></div></details>)}
  <p class="quiet">The disassembler can print mnemonic names for numeric atoms inside quoted data. A name such as <code>g1_negate</code> in a returned condition list does not mean that operator is executed; inspect the quoted context and serialized bytes.</p>
  <h2 id="vectors">Adversarial input vectors</h2>
  <p>Each named vector records native Rust and five CLVM executions: Chialisp, plus Rust and Rue with optimization off/on using the pipelines above. The generated sweep adds {format(puzzle.generated_cases)} input comparisons{puzzle.generated_cases ? ` ${generatedScope}` : ''}. A rejected VM run has no returned successful cost.</p>
  <p>Every build uses a ceiling of {format(puzzle.validation_max_cost ?? 1_000_000)} cost units per input in this comparison. Exhaustion is inconclusive and fails ordinary validation. This is a finite test budget, not a policy restriction or a guarantee that every possible input completes.</p>
  <p class="quiet">Long inputs use a bounded preview. The <a href={href('reports/validation.json')}>validation JSON</a> retains every exact input, output and execution envelope.</p>
  <div class="table-scroll"><table><caption>Named input outcomes and successful VM execution costs</caption><thead><tr><th scope="col">Case / solution</th><th scope="col">Native Rust</th><th scope="col">Rust / off</th><th scope="col">Rust / on</th><th scope="col">Chialisp</th><th scope="col">Rue / off</th><th scope="col">Rue / on</th></tr></thead><tbody>
    {puzzle.cases.map(test => <tr class:list={{ divergent: Boolean(test.declared_divergence) }}><th scope="row">{test.label}{test.declared_divergence && <span class="badge-divergence" title={test.declared_divergence.reason}>declared divergence</span>}<SolutionPreview value={test.solution} /></th><td><span class:list={['outcome', { accepted: test.native.status === 'accepted' }]}>{test.native.status}</span></td>{test.runs.map(run => <td><span class:list={['outcome', { accepted: run.execution.outcome.status === 'accepted', bound: test.declared_divergence?.backends.includes(run.backend) }]}>{run.execution.outcome.status}</span><small>{run.execution.cost === null ? 'cost unavailable' : `${format(run.execution.cost)} cost`}</small></td>)}</tr>)}
  </tbody></table></div>
  <p class="quiet">Execution cost excludes consensus condition costs and overall spend-bundle admission overhead. Accepted outputs and exact rejection diagnostics are available in the <a href={href('reports/validation.json')}>downloadable report</a>.</p>
  {declaredDivergences(puzzle).length > 0 && <div class="divergences" data-declared-divergences>
    <h3 id="divergences">Declared divergences from the original</h3>
    <p>{declaredDivergences(puzzle).length} of {puzzle.cases.length} named vectors declare, before execution, that the independently compiled original and the Rue translation produce a different result from the native Rust adapter. Each declared outcome is an independently specified CLVM result and the report checks the listed languages against it instead of against native Rust. Rust CLVM is never covered by a declaration: it must always match the native Rust source. These are recorded adapter differences, not compiler bugs and not evidence about inputs that were not run.</p>
    <div class="table-scroll"><table><caption>Declared outcomes for the independently compiled languages</caption><thead><tr><th scope="col">Case</th><th scope="col">Native Rust</th><th scope="col">Declared for</th><th scope="col">Declared outcome</th><th scope="col">Reason</th></tr></thead><tbody>
      {declaredDivergences(puzzle).map(test => <tr><th scope="row">{test.label}<br /><code class="divergence-solution">{test.solution}</code></th><td><span class:list={['outcome', { accepted: test.native.status === 'accepted' }]}>{test.native.status}</span>{test.native.output_hex && <small><code>{test.native.output_hex}</code></small>}</td><td>{test.declared_divergence!.backends.map(backendLabel).join(', ')}</td><td><span class:list={['outcome', { accepted: test.declared_divergence!.outcome.status === 'accepted' }]}>{test.declared_divergence!.outcome.status}</span>{test.declared_divergence!.outcome.output_hex && <small><code>{test.declared_divergence!.outcome.output_hex}</code></small>}</td><td>{test.declared_divergence!.reason}</td></tr>)}
    </tbody></table></div>
  </div>}
  {puzzle.resource_controls && <section aria-label="Lower-budget resource controls">
    <h2 id="resource-controls">What happens with a smaller budget?</h2>
    <p>These {puzzle.resource_controls.cases.length} inputs also run in every build with a {format(puzzle.resource_controls.max_cost)} cost ceiling. The {puzzle.resource_controls.cases.reduce((count, test) => count + test.runs.length, 0)} observations below are separate controls, excluded from the named and generated coverage totals. A typed <code>inconclusive / cost_exceeded</code> result records resource exhaustion; it does not establish policy rejection or ledger validity.</p>
    <div class="table-scroll"><table><caption>Same inputs and retained artifacts under the smaller cost budget</caption><thead><tr><th scope="col">Case</th><th scope="col">Native Rust</th><th scope="col">Rust / off</th><th scope="col">Rust / on</th><th scope="col">Chialisp</th><th scope="col">Rue / off</th><th scope="col">Rue / on</th></tr></thead><tbody>
      {puzzle.resource_controls.cases.map(test => <tr><th scope="row">{test.label}<details><summary>{test.solution.length > 512 ? 'Input preview' : 'Exact input'}</summary><SolutionPreview value={test.solution} /></details></th><td><span class:list={['outcome', { accepted: test.native.status === 'accepted' }]}>{test.native.status}</span></td>{test.runs.map(run => <td><span class:list={['outcome', { accepted: run.execution.outcome.status === 'accepted' }]}>{run.execution.outcome.status}</span><small>{run.execution.cost === null ? run.execution.failure?.code ?? 'cost unavailable' : `${format(run.execution.cost)} cost`}</small></td>)}</tr>)}
    </tbody></table></div>
    <p>The ordinary comparison above must still complete conclusively at its stated budget. See the <a href={href(puzzle.slug === 'password-coin' ? 'tutorials/password-coin/#inspect-the-evidence-and-its-limits' : 'tutorials/sha256tree/#validation-and-cost')}>cost and evidence discussion</a> and the full recorded envelopes in the report.</p>
  </section>}
  {puzzle.kind === 'program_factory' && <section aria-label="Produced program execution checks">
    <h2 id="factory">Apply the produced programs</h2>
    <p>The first-stage result is executable CLVM. The report records {puzzle.factory_checks?.length ?? 0} produced-program checks and {applicationCount} second-stage VM executions. {curryFactory ? <>Each build’s returned program must equal the independently constructed standard curried form, and applying it to every declared solution must equal running the module itself on the uncurried environment. Each application row records that expected outcome.</> : <>Each build’s returned program is applied to the recorded environments and compared with the expected payload bytes.</>} These finite replays are separate from an IR-model proof.</p>
    {[...factoryGroups].map(([environment, checks]) => <details class="artifact"><summary>Factory environment <code>{environment}</code> · {checks.length} builds</summary><div class="table-scroll" data-pagefind-ignore><table><caption>Second-stage applications of each returned program</caption><thead><tr><th scope="col">Build</th><th scope="col">Returned program</th><th scope="col">{curryFactory ? 'Expected program' : 'Expected payload'}</th><th scope="col">Applications</th></tr></thead><tbody>{checks.map(check => <tr><th scope="row">{backendLabel(check.backend)} / {check.optimize_lir ? 'on' : 'off'}</th><td class="hash"><code>{check.program_hex}</code></td><td class="hash"><code>{check.expected_output_hex}</code></td><td><span class:list={['outcome',{accepted:applicationPassed(check)}]}>{applicationPassed(check) ? 'pass' : 'fail'}</span><small>{check.application_runs.length} recorded environments</small></td></tr>)}</tbody></table></div></details>)}
    <p>{curryFactory ? <a href={href('tutorials/curry-hash/')}>Read the currying lesson.</a> : <a href={href('tutorials/p2-conditions/')}>Follow the raw-tree factory walkthrough.</a>} Full replay inputs, outputs, costs, and diagnostics remain in the JSON report.</p>
  </section>}
  {puzzle.curried_instances && <CurriedInstances evidence={puzzle.curried_instances} />}
  {puzzle.curried_examples && <CurriedExamples examples={puzzle.curried_examples} />}
  {singleton && <ProtocolValidation evidence={singleton} />}
  {delegated && <DelegatedConditionsValidation puzzle={puzzle} />}
  {delegated && <DelegatedSourceControls puzzle={puzzle} />}
  <h2 id="ledger">Ordinary ledger scenario groups</h2>
  {puzzle.simulator.length ? <div>
    <p>The same {puzzle.simulator.length} complete-spend scenario groups run separately against each language’s compiled program. A scenario can submit several bundles; these are scenario runs, not transaction counts. Equal VM outputs alone do not establish valid coin spends.</p>
    <p>Negative observations below come from actual consensus validation under <code>{report.simulator.rejection_protocol}</code>. SDK signing or preflight errors do not count as ledger rejection.</p>
    {[{backend: 'rust_mir', scenarios: puzzle.simulator}, ...puzzle.simulator_comparisons].map(run => <details class="artifact" data-ledger-language={run.backend}>
      <summary>{backendLabel(run.backend)} · {run.scenarios.length} optimized ledger scenario runs</summary>
      <ul class="scenarios">{run.scenarios.map(scenario => <li data-ledger-scenario={scenario.name}>
        <span class:list={['badge', { success: scenario.passed }]}>{scenario.passed ? 'pass' : 'fail'}</span> {scenario.name}
        {scenario.rejections.length ? <ul class="rejections" aria-label="Actual consensus rejection observations">{scenario.rejections.map(rejection => <li><code data-ledger-rejection={rejection.code}>{rejection.stage}/{rejection.code}</code></li>)}</ul> : <small class="accepted-spend">Accepted spend; no rejection expected.</small>}
      </li>)}</ul>
    </details>)}
  </div> : <div class="callout-note">{delegated ? 'This raw template uses the separate owner-instance evidence above. Its raw evaluations, actual SDK submissions and intentionally unsafe uncurried successes do not add ordinary scenario groups.' : singleton ? 'This component uses the separate canonical-counterpart composition evidence above. Its actual transaction submissions do not add to the ordinary ledger scenario-group totals. A successful raw module execution alone is not a complete spend.' : puzzle.curried_instances ? 'The ordinary comparisons cover the reusable raw module. The separate fixed-hash instance section above contains its actual spend observations; the raw module alone receives no password-locked spend credit.' : puzzle.kind === 'program_factory' ? 'This factory returns a program, not direct spend conditions. The second-stage VM checks above do not claim ledger admission or authorization.' : 'This pure function returns a CLVM value for a language example. Ledger validation is not applicable; successful evaluation is not presented as a valid coin spend.'}</div>}
  <h2 id="provenance">Provenance and versions</h2>
  <p><strong>{puzzle.provenance.classification}.</strong> {canonical ? `This ports one exact tutorial ${puzzle.reference_mode === 'expression' ? 'expression' : 'module'}. It does not complete its parent page, a canonical protocol module, or a CHIP migration.` : canonicalModule ? 'This ports one exact pinned canonical module. It does not complete its repository, a tutorial, or a CHIP; module identity and finite execution evidence have their own explicit scope.' : helperAdapter ? 'This ports one published helper through an explicit module adapter. It does not complete the source library, its macros, a protocol, or a CHIP. It makes no published module-hash compatibility claim.' : 'This original teaching fixture is not claimed as a canonical protocol replacement or completed CHIP migration.'}</p>
  {helper && <p><a href={href(`tutorials/${puzzle.slug}/`)}>Read the helper’s source span, license, input contract and reproduction steps.</a></p>}
  <ul>{puzzle.provenance.references.map(url => <li><a href={url}>{new URL(url).hostname}{new URL(url).pathname}</a></li>)}</ul>
  <p>Rue source SHA-256: <code class="dependency-hash" data-pagefind-ignore>{puzzle.rue.sha256}</code>. It is compiled independently; Rust’s use of Rue LIR does not substitute for this source comparison.</p>
  <RuntimeVersions />
  <details class="source-dependency" data-pagefind-ignore><summary>Declared Cargo input hashes</summary><p class="source-note">The validation and proof reports record the same explicitly declared local Cargo inputs. This is not a complete transitive dependency fingerprint.</p><ul>{authoring.sources.map(source => <li><code>{source.path}</code> · <code class="dependency-hash" data-pagefind-ignore>{source.sha256}</code></li>)}</ul></details>
  <p>Reproduce this corpus with <code>./scripts/chialisp-oxide validate --output corpus/validation.json</code>. Read <a href={href('verification/method/')}>the validation method and remaining assumptions</a> before interpreting a pass.</p>
</StarlightPage>
<style>
  h2 { margin: 2.7rem 0 1rem; } .scope { font-size: 1.05rem; }
  .table-scroll { max-width: 100%; overflow-x: auto; margin: 1.3rem 0; }
  table { width: 100%; border-collapse: collapse; font-size: .75rem; }
  caption { text-align: start; font-size: .7rem; color: var(--sl-color-gray-3); margin-bottom: .6rem; }
  th, td { text-align: start; padding: .75rem .65rem; border-bottom: 1px solid var(--oxide-line); vertical-align: top; }
  thead th { font-weight: 500; color: var(--sl-color-gray-2); background: var(--sl-color-bg-sidebar); }
  th { min-width: 7rem; } td { min-width: 5rem; }
  .hash { min-width: 12rem; max-width: 19rem; overflow-wrap: anywhere; font-size: .66rem; }
  .outcome { font-size: .73rem; color: var(--sl-color-gray-2); } .outcome.accepted { color: var(--oxide-green); }
  .outcome.bound { text-decoration: underline dotted; }
  .badge-divergence { display: inline-block; margin-inline-start: .4rem; padding: .05rem .4rem; border-radius: .6rem; font-size: .62rem; font-weight: 600; background: var(--sl-color-bg-sidebar); color: var(--sl-color-gray-2); border: 1px solid var(--oxide-line); vertical-align: middle; }
  .divergences { margin-block: 1.4rem; } .divergences td, .divergences th { font-size: .78rem; }
  .divergence-solution { font-size: .7rem; color: var(--sl-color-gray-3); word-break: break-all; }
  td small { display: block; color: var(--sl-color-gray-3); font: .6rem var(--sl-font-mono); margin-top: .3rem; white-space: nowrap; }
  .artifact { border: 1px solid var(--oxide-line); border-radius: 5px; margin-block: .8rem; padding: .9rem; font-size: .8rem; }
  .dependency-hash { overflow-wrap: anywhere; }
  .rejections { padding-inline-start: 1.5rem; margin-top: .4rem; } .rejections li { margin: .2rem 0; } .rejections code { overflow-wrap: anywhere; font-size: .72rem; } .accepted-spend { display: block; margin: .4rem 0 0 1.1rem; color: var(--sl-color-gray-3); }
  summary { cursor: pointer; } .artifact div { margin-top: 1rem; } .scenarios { list-style: none; padding: 0; } .scenarios li { margin: .75rem 0; }
</style>
