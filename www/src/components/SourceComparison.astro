---
import { Code } from '@astrojs/starlight/components';
import { puzzles, report, format, href, canonicalExample, canonicalPuzzle, canonicalHelper, helperContract } from '../lib/data';
import { sourceDataArtifacts } from '../lib/source-data.mjs';
interface Props { slug: string; supporting?: 'all' | 'reference_includes'; }
const puzzle = puzzles.find(p => p.slug === Astro.props.slug);
if (!puzzle) throw new Error(`Missing validated source comparison: ${Astro.props.slug}`);
const canonical = canonicalExample(puzzle);
const canonicalModule = canonicalPuzzle(puzzle);
const helperAdapter = canonicalHelper(puzzle);
const helper = helperContract(puzzle);
const sourceData = new Map(sourceDataArtifacts(report).map(entry => [entry.path, entry]));
// Focused lessons still retain the exact dataset download cards and hashes.
// Only supporting source-code drawers are limited to reference includes.
const dependencies = [...puzzle.source_dependencies, ...puzzle.rue.dependencies].filter(dependency => sourceData.has(dependency.path) || Astro.props.supporting !== 'reference_includes' || Object.values(puzzle.reference_includes ?? {}).includes(dependency.path));
const dependencyLanguage = (filename: string) => filename.endsWith('.json') ? 'json' : filename.endsWith('.hex') ? 'text' : /\.(?:clsp|clinc|clib)$/.test(filename) ? 'clsp' : 'rust';
---
<div class="source-comparison">
  <div class="split-source">
    <section class="source-column" aria-label="Chialisp source" data-language="chialisp">
      <div class="source-label"><span class="badge">{canonical ? (puzzle.reference_mode === 'expression' ? 'Original Chialisp expression' : 'Original Chialisp module') : canonicalModule ? 'Original Chialisp module' : helperAdapter ? 'Original helper + module adapter' : 'Chialisp reference'}</span> independent compiler · {canonical || canonicalModule ? 'no source wrapper' : helperAdapter ? 'explicit source wrapper' : 'same tested ABI'}</div>
      <Code code={puzzle.reference} lang="clsp" title={`puzzles/${puzzle.slug}/reference.clsp`} wrap preserveIndent />
    </section>
    <section class="source-column" aria-label="Rust source" data-language="rust">
      <div class="source-label"><span class="badge success">Rust source</span> exact recorded source · compiled from MIR</div>
      <Code code={puzzle.source} lang="rust" title={`puzzles/${puzzle.slug}/puzzle.rs`} wrap preserveIndent />
    </section>
    <section class="source-column" aria-label="Rue source" data-language="rue">
      <div class="source-label"><span class="badge">Rue source</span> independent Rue source compilation · same tested ABI</div>
      <Code code={puzzle.rue.source} lang="rust" title={puzzle.rue.path} wrap preserveIndent />
    </section>
  </div>
  <p class="source-note">Long lines wrap for reading. The copy buttons retain the source’s original line breaks.</p>
  {canonical && <p class="source-note">{puzzle.reference_mode === 'expression'
    ? <>The original expression is extracted from the pinned tutorial’s <code>run</code> command, without a <code>mod</code> wrapper. All three sources explicitly ignore their environment.</>
    : puzzle.environment === 'raw'
    ? <>The original module span is retained from the pinned tutorial without an adapter. The ports preserve its raw environment contract; instance commitments and spend observations are recorded separately.</>
    : <>The original module span is retained from the pinned tutorial without an adapter. The Rust port reads its arguments through the strict typed ABI as signed 64-bit integers; every difference from the original’s unbounded, positional environment reading is declared per case and checked against an independently specified result.</>}
    {' '}<a href={canonical.source.url}>Inspect its exact upstream source span.</a></p>}
  {canonicalModule && <p class="source-note">The original upstream module is retained byte for byte, without an adapter or added argument guard. The raw environment contract and published module identity are recorded separately from finite behavioral comparisons.</p>}
  {Object.keys(puzzle.reference_includes ?? {}).length > 0 && <p class="source-note" data-reference-includes>The independent reference compiler binds each include to its exact recorded supporting file: {Object.entries(puzzle.reference_includes ?? {}).map(([name, filename], index) => <>{index > 0 ? '; ' : ''}<code>{name}</code>{' → '}<code>{filename}</code></>)}. Undeclared includes fail.</p>}
  {helper && <p class="source-note">The original helper is retained verbatim inside the displayed module wrapper. {helper.source} Finite behavioral comparisons do not claim identity with a published standalone module.</p>}
  {dependencies.length > 0 && <div class="source-dependencies">
    <p class="source-note">Supporting files are recorded separately so fixture data and helper definitions do not obscure the puzzle policy.</p>
    {dependencies.map(dependency => <details class="source-dependency" data-source-dependency={dependency.path} data-source-language={dependencyLanguage(dependency.path)}>
      <summary>{sourceData.has(dependency.path) ? (sourceData.get(dependency.path)!.kind === 'manifest' ? 'Independent expected-relation recipes' : sourceData.get(dependency.path)!.kind === 'independent' ? 'Independent raw input recipes' : 'Generated validation inputs') : dependency.path.endsWith('/fixture_keys.rs') ? 'Public fixture key bytes' : 'Supporting source'}: <code>{dependency.path}</code></summary>
      <p class="source-note">{sourceData.has(dependency.path) ? 'Complete data from this fixture’s declared dependencies.' : 'Complete source from this fixture’s declared dependencies.'} SHA-256: <code class="dependency-hash" data-pagefind-ignore>{dependency.sha256}</code>.</p>
      {dependency.path.endsWith('/fixture_keys.rs') && <p class="source-note">These deterministic public test keys have publicly known secret seeds. Never use them for real funds.</p>}
      {sourceData.has(dependency.path) ? <p class="source-note" data-source-data-card>
        {format(sourceData.get(dependency.path)!.rows)} {sourceData.get(dependency.path)!.kind === 'manifest' ? 'relation recipes (50 named + 128 generated; no additional VM or coverage credit)' : sourceData.get(dependency.path)!.kind === 'independent' ? 'raw recipes (20 named + 180 disjoint generated; repeated replays do not add unique coverage)' : 'generated inputs'} · {format(sourceData.get(dependency.path)!.bytes)} bytes.
        {' '}<a href={href(`reports/source-data/${sourceData.get(dependency.path)!.basename}`)} download={sourceData.get(dependency.path)!.basename} data-source-download={sourceData.get(dependency.path)!.basename}>Download exact JSON</a>.
        {' '}Use this file to inspect or rerun the fixture’s input recipes.
      </p> : <Code code={dependency.source} lang={dependencyLanguage(dependency.path)} title={dependency.path} wrap preserveIndent />}
    </details>)}
  </div>}
</div>
