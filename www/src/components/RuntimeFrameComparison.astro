---
import baseline from '../../../corpus/runtime-frame-baseline.json';
import { puzzles, format, href } from '../lib/data';

interface Props { slug?: string }
const { slug } = Astro.props;
const rows = baseline.puzzles.filter(puzzle => !slug || puzzle.slug === slug).map(previous => {
  const current = puzzles.find(puzzle => puzzle.slug === previous.slug)!;
  const solution = previous.slug === 'last-list-element' ? '(())' : '(1 2 3)';
  const beforeCase = previous.cases.find(example => example.solution === solution)!;
  const currentCase = current.cases.find(example => example.solution === solution)!;
  const before = previous.artifacts.find(artifact => artifact.optimize_lir)!;
  const artifact = (backend: string) => current.artifacts.find(artifact => artifact.backend === backend && artifact.optimize_lir)!;
  const cost = (backend: string) => currentCase.runs.find(run => run.backend === backend && run.optimize_lir)!.execution.cost!;
  return {
    current, solution, before, artifact, cost,
    beforeCost: beforeCase.runs.find(run => run.optimize_lir)!.execution.cost!,
  };
});
---
<div class="runtime-measurements">
  {rows.map(row => <section>
    <h3><a href={href(`lab/${row.current.slug}/`)}>{row.current.title}</a></h3>
    <p>Same Rust source and input, compiled with the current optimized pipeline.</p>
    <dl>
      <div><dt>Optimized Rust size</dt><dd>{format(row.before.bytes)} → <strong>{format(row.artifact('rust_mir').bytes)} bytes</strong></dd></div>
      <div><dt>Chialisp / optimized Rue size</dt><dd>{format(row.artifact('chialisp').bytes)} / {format(row.artifact('rue_source').bytes)} bytes</dd></div>
      <div><dt>Input</dt><dd><code>{row.solution}</code></dd></div>
      <div><dt>Optimized Rust VM cost</dt><dd>{format(row.beforeCost)} → <strong>{format(row.cost('rust_mir'))}</strong></dd></div>
      <div><dt>Chialisp / optimized Rue VM cost</dt><dd>{format(row.cost('chialisp'))} / {format(row.cost('rue_source'))}</dd></div>
    </dl>
  </section>)}
  <p class="scope">The previous measurements come from <a href={`https://github.com/judeallred/chialisp-oxide/blob/${baseline.baseline.commit}/corpus/validation.json`}>the pinned release report</a>.
    The compiler CI gate replays its 58 retained Rust executions, checks all 29 named outcomes, and preserves every unoptimized artifact and the other recorded corpus evidence.
    The current column includes later constant folding and forward success facts as well as frame elision; this comparison does not isolate any one stage.
    These are measured examples, not a general speedup or optimizer proof. VM cost excludes condition and transaction-admission costs.</p>
</div>
<style>
  .runtime-measurements section { margin-block: 1.25rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; }
  h3 { margin: 0; }
  section p { margin-block: .5rem 1rem; }
  dl { margin: 0; }
  dl div { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1rem; padding-block: .45rem; border-top: 1px solid var(--sl-color-gray-6); }
  dt { color: var(--sl-color-gray-2); }
  dd { margin: 0; }
  .scope { font-size: .9rem; color: var(--sl-color-gray-2); }
</style>
