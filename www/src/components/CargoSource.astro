---
import { Code } from '@astrojs/starlight/components';
import manifest from '../../../examples/cargo-puzzles/Cargo.toml?raw';
import library from '../../../examples/cargo-puzzles/src/lib.rs?raw';
import build from '../../../examples/cargo-puzzles/build.rs?raw';
interface Props { file: 'manifest' | 'library' | 'build'; }
const sources = {
  manifest: { code: manifest, lang: 'toml', title: 'examples/cargo-puzzles/Cargo.toml' },
  library: { code: library, lang: 'rust', title: 'examples/cargo-puzzles/src/lib.rs' },
  build: { code: build, lang: 'rust', title: 'examples/cargo-puzzles/build.rs' },
};
const source = sources[Astro.props.file];
const testStart = Astro.props.file === 'library' ? library.indexOf('#[cfg(test)]') : -1;
const displayed = testStart < 0 ? source.code : library.slice(0, testStart);
---
<Code code={displayed} lang={source.lang} title={source.title} />
{testStart >= 0 && <details class="source-dependency">
  <summary>Native tests and complete library source</summary>
  <p class="source-note">The main view shows the actual library before its test module. This complete file also includes the native tests and their explicit wire-opcode assertions.</p>
  <Code code={library} lang="rust" title={`${source.title} · complete file including native tests`} />
</details>}
