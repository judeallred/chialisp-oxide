---
import predecessor from '../../../corpus/helper-inlining-baseline.json';
import baseline from '../../../corpus/runtime-refinement-baseline.json';
import { createHash } from 'node:crypto';
import { report, format, type PuzzleReport } from '../lib/data';
import { historicalOptimizationReport } from '../lib/p2-costs.mjs';

// Validate the actual current report before restoring the complete immutable
// cost checkpoint. Later compiler output must not replace these historical rows.
const puzzles = historicalOptimizationReport(report).puzzles as PuzzleReport[];

type ReviewedPuzzle = {
  slug: string;
  artifact: { backend: string; optimize_lir: boolean; bytes: number; clvm_hex: string; tree_hash: string };
  cases: { label: string; solution_sha256: string; execution: { outcome: { status: string; output_hex?: string }; cost: number | null } }[];
};
const reviewedPuzzles: readonly ReviewedPuzzle[] = baseline.reviewed_after.puzzles;
if (baseline.protocol !== 'chialisp-oxide-runtime-refinement/v1'
    || baseline.baseline.commit !== 'c87957e2d28c832ec76551aa0c5e16e31f973b2f'
    || baseline.baseline.report_sha256 !== predecessor.reviewed_after.report_sha256
    || baseline.predecessor.path !== 'corpus/helper-inlining-baseline.json'
    || baseline.predecessor.sha256 !== '0b7326f83065ab1bc186a1e9b0d3b5c581fa7cc3110845cc4b6db70a39b5da52'
    || baseline.reviewed_after.status !== 'reviewed_final'
    || predecessor.reviewed_after.puzzles.length !== 21
    || reviewedPuzzles.length !== 21) {
  throw new Error('Missing final reviewed interval and integer-decoder comparison');
}
const rows = predecessor.reviewed_after.puzzles.map((before, index) => {
  const puzzle = puzzles.find(puzzle => puzzle.slug === before.slug);
  if (!puzzle) throw new Error(`Missing optimization comparison: ${before.slug}`);
  const reviewed = reviewedPuzzles[index];
  const after = puzzle.artifacts.find(artifact => artifact.backend === 'rust_mir' && artifact.optimize_lir === true);
  const sample = before.cases.find(sample => sample.execution.outcome.status === 'accepted');
  const named = puzzle.cases.find(row => row.label === sample?.label);
  const current = named?.runs.find(run => run.backend === 'rust_mir' && run.optimize_lir === true)?.execution;
  const reviewedSample = reviewed?.cases.find(row => row.label === sample?.label);
  if (!reviewed || reviewed.slug !== before.slug || !after || !sample || !named || !current || !reviewedSample || current.outcome.status !== 'accepted'
      || reviewed.artifact.backend !== 'rust_mir' || reviewed.artifact.optimize_lir !== true
      || reviewed.artifact.bytes !== after.bytes || reviewed.artifact.clvm_hex !== after.clvm_hex
      || reviewed.artifact.tree_hash !== after.tree_hash
      || createHash('sha256').update(named.solution).digest('hex') !== sample.solution_sha256
      || reviewedSample.solution_sha256 !== sample.solution_sha256
      || reviewedSample.execution.cost !== current.cost || reviewedSample.execution.outcome.status !== 'accepted'
      || reviewedSample.execution.outcome.output_hex !== current.outcome.output_hex
      || sample.execution.cost === null || current.cost === null
      || !Number.isSafeInteger(sample.execution.cost) || sample.execution.cost < 0
      || !Number.isSafeInteger(current.cost) || current.cost < 0
      || !Number.isSafeInteger(before.artifact.bytes) || before.artifact.bytes <= 0
      || !Number.isSafeInteger(after.bytes) || after.bytes <= 0
      || sample.execution.outcome.output_hex !== current.outcome.output_hex) {
    throw new Error(`Incomplete optimization measurement: ${before.slug}`);
  }
  return { puzzle, before: before.artifact, after, label: sample.label, oldCost: sample.execution.cost, newCost: current.cost };
});
const deltas = predecessor.reviewed_after.puzzles.flatMap((before, index) => before.cases.flatMap((sample, caseIndex) => {
  if (sample.execution.outcome.status !== 'accepted') return [];
  const after = reviewedPuzzles[index].cases[caseIndex]?.execution;
  if (after?.outcome.status !== 'accepted' || sample.execution.cost === null || after.cost === null
      || after.outcome.output_hex !== sample.execution.outcome.output_hex) {
    throw new Error(`Invalid accepted-cost summary: ${before.slug}/${sample.label}`);
  }
  return [after.cost - sample.execution.cost];
}));
const lower = deltas.filter(delta => delta < 0).length;
const equal = deltas.filter(delta => delta === 0).length;
const higher = deltas.filter(delta => delta > 0).length;
const smaller = rows.filter(row => row.after.bytes < row.before.bytes);
---
<p>The retained 21-puzzle cost milestone is unchanged by the later pay-to-singleton addition. Its separate <a href="/chialisp-oxide/lab/p2-singleton/">P2 measurements</a> do not add a historical before/after row.</p>
<p data-cost-summary data-accepted={deltas.length} data-lower={lower} data-equal={equal} data-higher={higher}>Across {format(deltas.length)} accepted named inputs, {format(lower)} use less VM cost, {format(equal)} are unchanged, and {format(higher)} cost more. These finite counts cover the complete retained set.</p>
<p data-cost-changed-artifacts>Smaller modules in this iteration: {smaller.map((row, index) => <>{index > 0 ? '; ' : ''}<a href={`/chialisp-oxide/lab/${row.puzzle.slug}/`}>{row.puzzle.title}</a>{' '}{format(row.before.bytes)} → {format(row.after.bytes)} bytes</>)}.</p>
<div class="table-wrap">
  <table>
    <caption>Optimized Rust before and after interval and decoder refinement: first accepted named input per puzzle</caption>
    <thead><tr><th scope="col">Puzzle / input</th><th scope="col">Before bytes</th><th scope="col">Now bytes</th><th scope="col">Before VM cost</th><th scope="col">Now VM cost</th></tr></thead>
    <tbody>{rows.map(row => <tr data-cost-puzzle={row.puzzle.slug}>
      <th scope="row"><a href={`/chialisp-oxide/lab/${row.puzzle.slug}/`}>{row.puzzle.title}</a><small>{row.label}</small></th>
      <td>{format(row.before.bytes)}</td><td>{format(row.after.bytes)}</td>
      <td>{format(row.oldCost)}</td><td>{format(row.newCost)}</td>
    </tr>)}</tbody>
  </table>
</div>
<p class="quiet">The before measurements come from signed commit <a href={`${baseline.baseline.repository}/commit/${baseline.baseline.commit}`}><code>{baseline.baseline.commit.slice(0, 8)}</code></a>. Both columns enable optimization. Inputs and accepted output bytes agree; each row links to the complete Chialisp, Rust and Rue comparison. These are individual executed inputs, not averages or a universal performance bound. The <a href="/chialisp-oxide/reports/runtime-refinement-baseline.json">reviewed interval and decoder transition</a>, its unchanged <a href="/chialisp-oxide/reports/helper-inlining-baseline.json">helper-inlining</a> and <a href="/chialisp-oxide/reports/cost-optimization-baseline.json">earlier cost snapshots</a>, and the <a href="/chialisp-oxide/reports/validation.json">current validation report</a> retain the finite observations. Module bytes and primary VM execution cost exclude transaction-generator encoding and condition costs.</p>
<style>
  .table-wrap { overflow-x: auto; }
  table { width: 100%; font-size: .8rem; }
  caption { text-align: left; padding-bottom: .75rem; color: var(--sl-color-gray-2); }
  td { white-space: nowrap; }
  th { text-align: left; }
  small { display: block; font-weight: normal; color: var(--sl-color-gray-2); }
</style>
