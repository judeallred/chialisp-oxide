[package]
name = "chialisp-oxide-puzzles"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
path = "lib.rs"

[dependencies]
chialisp-oxide = { path = "../crates/chialisp-oxide", version = "0.1.0", features = ["alloc"] }

[dev-dependencies]
# Native tests evaluate `apply` through the pinned VM; CLVM extraction builds
# the library without this feature and sees the reserved panic body.
chialisp-oxide = { path = "../crates/chialisp-oxide", version = "0.1.0", features = ["alloc", "vm"] }
