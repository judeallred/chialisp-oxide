// Independent translation of the pinned tutorial's four positional fields.
// This is the selected tutorial source, not a claim of canonical wallet bytes.
const ATOM_DOMAIN: Bytes = 0x01;
const PAIR_DOMAIN: Bytes = 0x02;
fn hash_tree(value: Any) -> Bytes32 {
    if value is (Any, Any) {
        let first_hash = hash_tree(value.first);
        let rest_hash = hash_tree(value.rest);
        sha256(...[PAIR_DOMAIN, first_hash, rest_hash])
    } else {
        assert value is Bytes;
        sha256(...[ATOM_DOMAIN, value])
    }
}
fn main(synthetic_key: Any, original_key: Any, delegated_puzzle: fn(...solution: Any) -> Any, solution: Any) -> Any {
    if original_key is nil {
        let conditions = delegated_puzzle(...solution);
        ((50, (synthetic_key, (hash_tree(delegated_puzzle), nil))), conditions)
    } else {
        assert original_key is PublicKey;
        assert synthetic_key is Bytes;
        let offset = sha256(...[original_key as Bytes, hash_tree(delegated_puzzle)]);
        let calculated = g1_sum([original_key, pubkey_for_exp(offset)]);
        assert synthetic_key == (calculated as Bytes);
        delegated_puzzle(...solution)
    }
}
