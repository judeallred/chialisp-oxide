// Authored Rue comparison of the paired policy, with explicit untrusted ABI checks.
fn main(...solution: Any) -> List<Condition> {
    assert solution is (Bool, (Bytes32, nil));
    let recovery = solution.first;
    let message = solution.rest.first;
    [AggSigMe {
         public_key: if recovery { RECOVERY_PUBLIC_KEY } else { OWNER_PUBLIC_KEY },
         message,
     },
     AssertSecondsAbsolute { seconds: if recovery { RECOVERY_AT } else { 0 } },
     AssertMyAmount { amount: COIN_AMOUNT },
     CreateCoin { puzzle_hash: RECIPIENT, amount: COIN_AMOUNT }]
}

const COIN_AMOUNT: Int = 1000;
const RECIPIENT: Bytes32 = 0x4242424242424242424242424242424242424242424242424242424242424242;
// Absolute Unix timestamp and public fixture keys; these are not secret keys.
const RECOVERY_AT: Int = 100;
const OWNER_PUBLIC_KEY: PublicKey = 0x8bc61e93380f3427ed2ace813fdff67504f55268a99a72cea57133c2b32a1d836fd52381ae9ca10957557b80064059e5 as PublicKey;
const RECOVERY_PUBLIC_KEY: PublicKey = 0xb47fa1e15162a5b1f9444d1aae57d131a1d5c98bade8f8e93b8ebfe1649b95c55787b8731d2f1a0638b3e1d23ada48e8 as PublicKey;
