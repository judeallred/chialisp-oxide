; Structural IR model only: all finite trees/byte sequences, no VM cost/compiler-preservation proof.
(set-logic ALL)
(set-option :pp.min-alias-size 1000000)
(declare-datatypes ((Tree 0)) (((atom (atom_bytes (Seq (_ BitVec 8)))) (pair (pair_first Tree) (pair_rest Tree)))))
(declare-const env Tree)
(define-fun tree_v_0 () Bool true)
(define-fun tree_v_1 () Bool ((_ is pair) env))
(define-fun tree_v_2 () Bool tree_v_0)
(define-fun tree_v_3 () Bool (not tree_v_1))
(define-fun tree_v_4 () Bool tree_v_2)
(define-fun tree_v_5 () Bool true)
(define-fun tree_v_6 () Tree (atom (as seq.empty (Seq (_ BitVec 8)))))
(define-fun tree_v_7 () Bool tree_v_5)
(define-fun tree_v_8 () Bool true)
(define-fun tree_v_9 () Bool ((_ is pair) env))
(define-fun tree_v_10 () Bool tree_v_8)
(define-fun tree_v_11 () Bool true)
(define-fun tree_v_12 () Tree (atom (seq.unit #x01)))
(define-fun tree_v_13 () Bool tree_v_11)
(define-fun tree_v_14 () Bool true)
(define-fun tree_v_15 () Tree (pair_first env))
(define-fun tree_v_16 () Bool (and tree_v_14 ((_ is pair) env)))
(define-fun tree_v_17 () Tree (pair tree_v_12 tree_v_15))
(define-fun tree_v_18 () Bool (and tree_v_13 tree_v_16))
(define-fun tree_v_19 () Bool false)
(define-fun tree_v_20 () Bool (and tree_v_10 (ite tree_v_9 tree_v_18 tree_v_19)))
(define-fun tree_v_21 () Tree (ite tree_v_3 tree_v_6 tree_v_17))
(define-fun tree_v_22 () Bool (and tree_v_4 (ite tree_v_3 tree_v_7 tree_v_20)))
(assert ((_ is atom) env))
(assert (or (not (= tree_v_22 false)) (and tree_v_22 false (or (not (and true (and true ((_ is pair) env)))) (not (= tree_v_21 (pair (atom (seq.unit #x01)) (pair_first env))))))))
(check-sat)
