; Structural IR model only: all finite trees/byte sequences, no VM cost/compiler-preservation proof.
(set-logic ALL)
(set-option :pp.min-alias-size 1000000)
(declare-datatypes ((Tree 0)) (((atom (atom_bytes (Seq (_ BitVec 8)))) (pair (pair_first Tree) (pair_rest Tree)))))
(declare-const env Tree)
(define-fun tree_v_0 () Bool true)
(define-fun tree_v_1 () Tree (atom (seq.unit #x01)))
(define-fun tree_v_2 () Bool tree_v_0)
(define-fun tree_v_3 () Bool true)
(define-fun tree_v_4 () Tree (pair_first env))
(define-fun tree_v_5 () Bool (and tree_v_3 ((_ is pair) env)))
(define-fun tree_v_6 () Tree (pair tree_v_1 tree_v_4))
(define-fun tree_v_7 () Bool (and tree_v_2 tree_v_5))
(assert ((_ is pair) env))
(check-sat)
