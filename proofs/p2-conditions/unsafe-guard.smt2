; Structural IR equivalence only: rejection/output equality, excluding diagnostics, cost and compiler preservation.
(set-logic ALL)
(set-option :pp.min-alias-size 1000000)
(declare-datatypes ((Tree 0)) (((atom (atom_bytes (Seq (_ BitVec 8)))) (pair (pair_first Tree) (pair_rest Tree)))))
(declare-const env Tree)
(define-fun tree_v_0 () Bool true)
(define-fun tree_v_1 () Bool ((_ is pair) env))
(define-fun tree_v_2 () Bool tree_v_0)
(define-fun tree_v_3 () Bool true)
(define-fun tree_v_4 () Tree (atom (seq.unit #xaa)))
(define-fun tree_v_5 () Bool tree_v_3)
(define-fun tree_v_6 () Bool false)
(define-fun tree_v_7 () Bool (and tree_v_2 (ite tree_v_1 tree_v_5 tree_v_6)))
(define-fun tree_v_8 () Bool true)
(define-fun tree_v_9 () Tree (atom (seq.unit #xaa)))
(define-fun tree_v_10 () Bool tree_v_8)
(assert ((_ is atom) env))
(assert (or (not (= tree_v_7 tree_v_10)) (and tree_v_7 tree_v_10 (not (= tree_v_4 tree_v_9)))))
(check-sat)
