; Structural IR model only: all finite trees/byte sequences, no VM cost/compiler-preservation proof.
(set-logic ALL)
(set-option :pp.min-alias-size 1000000)
(declare-datatypes ((Tree 0)) (((atom (atom_bytes (Seq (_ BitVec 8)))) (pair (pair_first Tree) (pair_rest Tree)))))
(declare-const env Tree)
(define-fun tree_v_0 () Bool true)
(define-fun tree_v_1 () Bool ((_ is pair) env))
(define-fun tree_v_2 () Bool tree_v_0)
(define-fun tree_v_3 () Bool (not tree_v_1))
(define-fun tree_v_4 () Bool tree_v_2)
(define-fun tree_v_5 () Bool false)
(define-fun tree_v_6 () Bool true)
(define-fun tree_v_7 () Bool ((_ is pair) env))
(define-fun tree_v_8 () Bool tree_v_6)
(define-fun tree_v_9 () Bool true)
(define-fun tree_v_10 () Tree (atom (seq.unit #x01)))
(define-fun tree_v_11 () Bool tree_v_9)
(define-fun tree_v_12 () Bool true)
(define-fun tree_v_13 () Tree (pair_first env))
(define-fun tree_v_14 () Bool (and tree_v_12 ((_ is pair) env)))
(define-fun tree_v_15 () Tree (pair tree_v_10 tree_v_13))
(define-fun tree_v_16 () Bool (and tree_v_11 tree_v_14))
(define-fun tree_v_17 () Bool false)
(define-fun tree_v_18 () Bool (and tree_v_8 (ite tree_v_7 tree_v_16 tree_v_17)))
(define-fun tree_v_19 () Bool (and tree_v_4 (ite tree_v_3 tree_v_5 tree_v_18)))
(assert ((_ is atom) env))
(check-sat)
